# ---------------------------------------------------------------------------
# ClaimLine AI — secrets template  (SHAPE ONLY, no real values)
#
# Local use:
#   cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#   then fill in the real values.  secrets.toml is gitignored — never commit it.
#
# Streamlit Community Cloud:
#   do NOT upload a file. Open your app → ⋮ → Settings → Secrets, and paste
#   the *contents* of your filled-in secrets.toml into that box. Cloud keeps it
#   encrypted and injects it as st.secrets at runtime.
# ---------------------------------------------------------------------------


# --- Retell website widget -------------------------------------------------
# The PUBLIC key only. Find it in the Retell dashboard under the widget /
# embed instructions — it starts with "public_key_".
#
# It is meant to be visible in page source: that is the whole point of the
# public-key flow (the browser talks to Retell directly, so you need no backend
# token server). Your Retell PRIVATE API key must never appear here or anywhere
# else in this repo.
[retell]
public_key    = "public_key_xxxxxxxxxxxxxxxxxxxxxxxx"
agent_id      = "agent_xxxxxxxxxxxxxxxxxxxxxxxx"
agent_version = ""        # optional; leave blank to always serve the published version


# --- Google Sheets ---------------------------------------------------------
# spreadsheet_id is the long string in the sheet's URL, between /d/ and /edit:
#   https://docs.google.com/spreadsheets/d/THIS_PART_HERE/edit#gid=0
[sheets]
spreadsheet_id = "1AbCdEfGhIjKlMnOpQrStUvWxYz0123456789"
claims_tab     = "Claims"


# --- Google service account ------------------------------------------------
# Paste the JSON key file you downloaded from Google Cloud, converted to TOML
# (each JSON key becomes a TOML key under this section).
#
# TWO THINGS PEOPLE GET WRONG HERE:
#
#  1. private_key must be ONE line in triple quotes with literal \n escapes,
#     exactly as it appears inside the JSON file. Do not paste a real multi-line
#     PEM block and do not strip the \n — google-auth will fail to parse it.
#
#  2. Share the Google Sheet with client_email (as a Viewer) from the Sheets
#     "Share" dialog. A service account is a separate identity from your own
#     Google account; if you skip this step every read returns a 403 no matter
#     how correct the credentials are.
[gcp_service_account]
type                        = "service_account"
project_id                  = "your-project-id"
private_key_id              = "0000000000000000000000000000000000000000"
private_key                 = """-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBg...REPLACE_ME...\n-----END PRIVATE KEY-----\n"""
client_email                = "claimline-dashboard@your-project-id.iam.gserviceaccount.com"
client_id                   = "000000000000000000000"
auth_uri                    = "https://accounts.google.com/o/oauth2/auth"
token_uri                   = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url        = "https://www.googleapis.com/robot/v1/metadata/x509/claimline-dashboard%40your-project-id.iam.gserviceaccount.com"
universe_domain             = "googleapis.com"
