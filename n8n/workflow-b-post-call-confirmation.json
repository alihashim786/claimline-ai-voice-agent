{
  "name": "ClaimLine B — Post-Call Confirmation & Logging",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "claimline-post-call",
        "responseMode": "onReceived",
        "options": {
          "responseCode": 200
        }
      },
      "id": "b1000000-0000-4000-8000-000000000001",
      "name": "Webhook (call_analyzed)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -1080,
        400
      ],
      "webhookId": "claimline-post-call-webhook",
      "notes": "Response Mode is 'Immediately'. Retell only needs a 200 to know the event was delivered; making it wait for Gmail would risk Retell retrying and sending duplicate emails."
    },
    {
      "parameters": {
        "jsCode": "// ---------------------------------------------------------------\n// Flatten Retell's call_analyzed payload into a flat object.\n//\n// Retell nests the fields you configured under Post-Call Data\n// Extraction quite deeply:\n//   body.call.call_analysis.custom_analysis_data.claim_filed\n// Referencing that path directly in six different nodes is how these\n// workflows become unmaintainable, and it is the single most common\n// reason a post-call workflow \"runs green but does nothing\" -- one\n// mistyped path silently yields undefined instead of an error.\n// We resolve it once, here, and defend against Retell changing the\n// nesting by also checking a couple of alternative locations.\n// ---------------------------------------------------------------\n\nconst body = $json.body ?? $json;\nconst call = body.call ?? body;\nconst analysis = call.call_analysis ?? {};\nconst data =\n  analysis.custom_analysis_data ??\n  body.custom_analysis_data ??\n  body.post_call_analysis ??\n  {};\n\nconst str = (v) => (v === undefined || v === null ? '' : String(v).trim());\n\n// Post-Call Data Extraction can return a real boolean or the strings\n// \"true\"/\"false\"; normalise both to a real boolean so the IF node has\n// one predictable type to test.\nconst rawFiled = data.claim_filed;\nconst claimFiled =\n  rawFiled === true || String(rawFiled).toLowerCase() === 'true';\n\nconst pad = (n) => String(n).padStart(2, '0');\nconst now = new Date();\nconst timestamp =\n  `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())} ` +\n  `${pad(now.getHours())}:${pad(now.getMinutes())}`;\n\nreturn [\n  {\n    json: {\n      event: str(body.event) || 'call_analyzed',\n      call_id: str(call.call_id),\n      claim_filed: claimFiled,\n      claim_id: str(data.claim_id),\n      urgency: str(data.urgency) || 'n/a',\n      name: str(data.name),\n      email: str(data.email).toLowerCase(),\n      incident_type: str(data.incident_type) || 'n/a',\n      call_summary: str(analysis.call_summary),\n      timestamp\n    }\n  }\n];"
      },
      "id": "b1000000-0000-4000-8000-000000000003",
      "name": "Flatten Retell Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -640,
        400
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "if-claim-filed",
              "leftValue": "={{ $json.claim_filed }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "b1000000-0000-4000-8000-000000000004",
      "name": "IF claim_filed",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -400,
        400
      ]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "=Your ClaimLine claim {{ $json.claim_id }} has been filed",
        "emailType": "html",
        "message": "=<div style=\"font-family:-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;max-width:560px;margin:0 auto;color:#1f2937;\">\n  <div style=\"background:#0f3d5c;padding:24px 28px;border-radius:10px 10px 0 0;\">\n    <div style=\"color:#ffffff;font-size:20px;font-weight:700;letter-spacing:-0.01em;\">ClaimLine Insurance</div>\n    <div style=\"color:#9fc6dd;font-size:13px;margin-top:4px;\">Claim confirmation</div>\n  </div>\n  <div style=\"border:1px solid #e5e7eb;border-top:none;border-radius:0 0 10px 10px;padding:28px;\">\n    <p style=\"margin:0 0 16px;font-size:15px;\">Hi {{ $json.name || 'there' }},</p>\n    <p style=\"margin:0 0 20px;font-size:15px;line-height:1.6;\">Thank you for calling ClaimLine. Your claim has been filed and is now in our system.</p>\n    <table style=\"width:100%;border-collapse:collapse;font-size:14px;margin:0 0 20px;\">\n      <tr><td style=\"padding:10px 0;border-bottom:1px solid #f0f1f3;color:#6b7280;\">Claim ID</td><td style=\"padding:10px 0;border-bottom:1px solid #f0f1f3;font-weight:700;text-align:right;\">{{ $json.claim_id }}</td></tr>\n      <tr><td style=\"padding:10px 0;border-bottom:1px solid #f0f1f3;color:#6b7280;\">Priority</td><td style=\"padding:10px 0;border-bottom:1px solid #f0f1f3;font-weight:600;text-align:right;\">{{ $json.urgency }}</td></tr>\n      <tr><td style=\"padding:10px 0;border-bottom:1px solid #f0f1f3;color:#6b7280;\">Status</td><td style=\"padding:10px 0;border-bottom:1px solid #f0f1f3;font-weight:600;text-align:right;\">Filed</td></tr>\n      <tr><td style=\"padding:10px 0;color:#6b7280;\">Filed on</td><td style=\"padding:10px 0;text-align:right;\">{{ $json.timestamp }}</td></tr>\n    </table>\n    <p style=\"margin:0 0 8px;font-size:15px;font-weight:600;\">What happens next</p>\n    <p style=\"margin:0 0 20px;font-size:14px;line-height:1.6;color:#374151;\">{{ $json.urgency === 'Urgent' ? 'Your claim has been flagged as urgent and will be reviewed within 24 to 48 hours. A claims specialist may contact you directly.' : 'Your claim will be reviewed within 5 to 7 business days once all required documents have been received.' }}</p>\n    <p style=\"margin:0 0 20px;font-size:14px;line-height:1.6;color:#374151;\">You can check your claim status at any time by calling back and providing your claim ID.</p>\n    <p style=\"margin:0;font-size:13px;color:#6b7280;line-height:1.6;\">ClaimLine Insurance &middot; support@claimlineinsurance.com &middot; +92 300 7654321<br>Monday to Saturday, 9:00 AM to 6:00 PM. The AI claims assistant is available 24/7.</p>\n    <p style=\"margin:20px 0 0;padding-top:16px;border-top:1px solid #f0f1f3;font-size:12px;color:#9ca3af;\">This is a portfolio demonstration project. ClaimLine Insurance is fictional and no real policy or claim data is involved.</p>\n  </div>\n</div>",
        "options": {
          "senderName": "ClaimLine Insurance",
          "appendAttribution": false
        }
      },
      "id": "b1000000-0000-4000-8000-000000000005",
      "name": "Gmail — Send Confirmation",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        -140,
        260
      ],
      "onError": "continueRegularOutput",
      "notes": "On Error is set to 'Continue' so a bad/missing caller email cannot stop the analytics row from being logged. The dashboard should still show the call even if the email bounced."
    },
